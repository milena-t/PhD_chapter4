\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Line-biased genes in males}. (\textbf  {A}, \textbf  {B}, \textbf  {C}): Genes significantly differentially expressed in each developmental timepoint (FDR-p $<$ 0.05), genes that are line-biased in females are excluded. Figure legend shows numbers of nonsignificant (nonsig.) genes, and genes that are significantly up- or downregulated, with upregulated genes being biased towards the large male haplotype in the large-small contrast. (\textbf  {D}, \textbf  {E}, \textbf  {F}): log2FC of genes that show significant line-bias in male samples, female samples or both. All genes that are exclusively male-biased (yellow) are also significant in the line-by-sex interaction. (\textbf  {G}): UpSet plot showing the overlap of line-significant genes identified in A-F. \relax }}{}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{day_split}{{1}{}{\textbf {Line-biased genes in males}. (\textbf {A}, \textbf {B}, \textbf {C}): Genes significantly differentially expressed in each developmental timepoint (FDR-p $<$ 0.05), genes that are line-biased in females are excluded. Figure legend shows numbers of nonsignificant (nonsig.) genes, and genes that are significantly up- or downregulated, with upregulated genes being biased towards the large male haplotype in the large-small contrast. (\textbf {D}, \textbf {E}, \textbf {F}): log2FC of genes that show significant line-bias in male samples, female samples or both. All genes that are exclusively male-biased (yellow) are also significant in the line-by-sex interaction. (\textbf {G}): UpSet plot showing the overlap of line-significant genes identified in A-F. \relax }{figure.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Sex bias across developmental stages}. (\textbf  {A}, \textbf  {B}, \textbf  {C}): Genes that are significantly sex-biased in each developmental time point (Y-haplotype line modelled as fixed effect). Upregulated genes are female-biased in the female-male contrast. (\textbf  {D}, \textbf  {E}): UpSet plots showing the overlap of genes that are significant in the day-by-sex interaction overlapping with genes that are sex biased on any time point in the full dataset (\textbf  {D}) or time-biased in the day-split data (\textbf  {E}). Only intersections with at least 15 or 20 genes are shown. \relax }}{}{figure.caption.2}\protected@file@percent }
\newlabel{sex_split}{{2}{}{\textbf {Sex bias across developmental stages}. (\textbf {A}, \textbf {B}, \textbf {C}): Genes that are significantly sex-biased in each developmental time point (Y-haplotype line modelled as fixed effect). Upregulated genes are female-biased in the female-male contrast. (\textbf {D}, \textbf {E}): UpSet plots showing the overlap of genes that are significant in the day-by-sex interaction overlapping with genes that are sex biased on any time point in the full dataset (\textbf {D}) or time-biased in the day-split data (\textbf {E}). Only intersections with at least 15 or 20 genes are shown. \relax }{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Sex bias across developmental stages}. (\textbf  {A}, \textbf  {B}, \textbf  {C}): Day-split data showing sex bias of large and small male haplotype lines in each day. Genes that are significant in the sex-by-line interaction of the individual day are highlighted. (\textbf  {D}): UpSet plot showing the overlap of sex biased genes \relax }}{}{figure.caption.3}\protected@file@percent }
\newlabel{sex_split}{{3}{}{\textbf {Sex bias across developmental stages}. (\textbf {A}, \textbf {B}, \textbf {C}): Day-split data showing sex bias of large and small male haplotype lines in each day. Genes that are significant in the sex-by-line interaction of the individual day are highlighted. (\textbf {D}): UpSet plot showing the overlap of sex biased genes \relax }{figure.caption.3}{}}
\gdef \@abspage@last{3}
