\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Line-biased genes in males}. (\textbf  {A}, \textbf  {B}, \textbf  {C}): Genes significantly differentially expressed in each developmental timepoint (FDR-p $<$ 0.05), genes that are line-biased in females are excluded. Figure legend shows numbers of nonsignificant (nonsig.) genes, and genes that are significantly up- or downregulated. (\textbf  {D}, \textbf  {E}, \textbf  {F}): log2FC of genes that show significant line-bias in male samples, female samples or both. All genes that are exclusively male-biased (yellow) are also significant in the line-by-sex interaction. (\textbf  {G}): UpSet plot showing the overlap of line-significant genes identified in A-F. \relax }}{}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{day_split}{{1}{}{\textbf {Line-biased genes in males}. (\textbf {A}, \textbf {B}, \textbf {C}): Genes significantly differentially expressed in each developmental timepoint (FDR-p $<$ 0.05), genes that are line-biased in females are excluded. Figure legend shows numbers of nonsignificant (nonsig.) genes, and genes that are significantly up- or downregulated. (\textbf {D}, \textbf {E}, \textbf {F}): log2FC of genes that show significant line-bias in male samples, female samples or both. All genes that are exclusively male-biased (yellow) are also significant in the line-by-sex interaction. (\textbf {G}): UpSet plot showing the overlap of line-significant genes identified in A-F. \relax }{figure.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Sex bias across developmental stages}. (\textbf  {A}): UpSet plot showing the overlap of significantly sex-biased genes during different time points with each other and the genes that are significant in the day-by-sex interaction. \relax }}{}{figure.caption.2}\protected@file@percent }
\newlabel{sex_split}{{2}{}{\textbf {Sex bias across developmental stages}. (\textbf {A}): UpSet plot showing the overlap of significantly sex-biased genes during different time points with each other and the genes that are significant in the day-by-sex interaction. \relax }{figure.caption.2}{}}
