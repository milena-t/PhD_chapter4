\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Line-biased genes in males}. (\textbf  {A}, \textbf  {B}, \textbf  {C}): Genes significantly differentially expressed (red=FDR-p $<$ 0.05) in each developmental timepoint (301 genes in day 14, 281 genes in day 16, 14 genes in day 18). Genes that are also line-biased in females are not shown. All genes are also significant in the line-by-sex interaction. (\textbf  {D}, \textbf  {E}, \textbf  {F}): log2FC of genes that show significant line-bias in male samples, female samples or both. (\textbf  {G}): Upsetplot showing the overlap of line-significant genes identified in A-F. \relax }}{}{figure.caption.1}\protected@file@percent }
