\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Line-biased genes in males}. (\textbf  {A}, \textbf  {B}, \textbf  {C}): Genes significantly differentially expressed in each developmental timepoint (FDR-p $<$ 0.05), genes that are line-biased in females are excluded. Figure legend shows numbers of nonsignificant (nonsig.) genes, and genes that are significantly up- or downregulated, with upregulated genes being biased towards the large male haplotype in the large-small contrast. (\textbf  {D}): UpSet plot showing the overlap of line-significant genes identified in A-C. \relax }}{}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{day_split}{{1}{}{\textbf {Line-biased genes in males}. (\textbf {A}, \textbf {B}, \textbf {C}): Genes significantly differentially expressed in each developmental timepoint (FDR-p $<$ 0.05), genes that are line-biased in females are excluded. Figure legend shows numbers of nonsignificant (nonsig.) genes, and genes that are significantly up- or downregulated, with upregulated genes being biased towards the large male haplotype in the large-small contrast. (\textbf {D}): UpSet plot showing the overlap of line-significant genes identified in A-C. \relax }{figure.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Sex bias across developmental stages}. (\textbf  {A}, \textbf  {B}, \textbf  {C}): Genes that are significantly sex-biased in each developmental time point (Y-haplotype line modelled as fixed effect). Upregulated genes are female-biased in the female-male contrast. (\textbf  {D}): UpSet plots showing the overlap of genes that are significant in the day-by-sex interaction overlapping with genes that are sex biased on any time point in the full dataset. Only intersections with at least 30 genes are shown. \relax }}{}{figure.caption.2}\protected@file@percent }
\newlabel{sex_split}{{2}{}{\textbf {Sex bias across developmental stages}. (\textbf {A}, \textbf {B}, \textbf {C}): Genes that are significantly sex-biased in each developmental time point (Y-haplotype line modelled as fixed effect). Upregulated genes are female-biased in the female-male contrast. (\textbf {D}): UpSet plots showing the overlap of genes that are significant in the day-by-sex interaction overlapping with genes that are sex biased on any time point in the full dataset. Only intersections with at least 30 genes are shown. \relax }{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Sex bias across developmental stages}. (\textbf  {A}, \textbf  {B}, \textbf  {C}): Day-split data showing sex bias of large and small male haplotype lines in each day. Genes that are significant in the sex-by-line interaction of the individual day are highlighted. (\textbf  {D}): UpSet plot showing the overlap of sex biased genes. \relax }}{}{figure.caption.3}\protected@file@percent }
\newlabel{sex_split}{{3}{}{\textbf {Sex bias across developmental stages}. (\textbf {A}, \textbf {B}, \textbf {C}): Day-split data showing sex bias of large and small male haplotype lines in each day. Genes that are significant in the sex-by-line interaction of the individual day are highlighted. (\textbf {D}): UpSet plot showing the overlap of sex biased genes. \relax }{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Intersection of sex bias and line bias across developmental stages}. Log2FC of sex-bias (females - males contrast) difference between the lines (SB small-Y - SB large-Y difference) and line-bias (small-Y - large-Y contrast) in males of day 14 (\textbf  {A}), day 16 (\textbf  {B}) and day 18 (\textbf  {C}), genes that are also line-biased in females are excluded. (\textbf  {D}): Magnitude of 129 male-biased genes that are significant in all time points and both selection lines. Significance is tested via Mann-Whitney-U, day14 (small-Y vs. large-Y): U = 100653.0, p = 0.010; day16 (small-Y vs. large-Y): U = 94097.0, p $<$ 0.0001; day18 (small-Y vs. large-Y): U = 107263.0, p = 0.324; small-Y (day 14 vs. day 18): U = 169800.0, p $<$ 0.0001; large-Y (day 14 vs. day 18): U = 172706.0, p $<$ 0.0001 \relax }}{}{figure.caption.4}\protected@file@percent }
\newlabel{sex_split}{{4}{}{\textbf {Intersection of sex bias and line bias across developmental stages}. Log2FC of sex-bias (females - males contrast) difference between the lines (SB small-Y - SB large-Y difference) and line-bias (small-Y - large-Y contrast) in males of day 14 (\textbf {A}), day 16 (\textbf {B}) and day 18 (\textbf {C}), genes that are also line-biased in females are excluded. (\textbf {D}): Magnitude of 129 male-biased genes that are significant in all time points and both selection lines. Significance is tested via Mann-Whitney-U, day14 (small-Y vs. large-Y): U = 100653.0, p = 0.010; day16 (small-Y vs. large-Y): U = 94097.0, p $<$ 0.0001; day18 (small-Y vs. large-Y): U = 107263.0, p = 0.324; small-Y (day 14 vs. day 18): U = 169800.0, p $<$ 0.0001; large-Y (day 14 vs. day 18): U = 172706.0, p $<$ 0.0001 \relax }{figure.caption.4}{}}
